---
import { getCollection } from 'astro:content';

const articles = await getCollection(
    'news',
    ({ data }) => data.featured === true
);

const article = articles.sort(
    (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime()
)[0];
---

{article && (
    <section class="news-hero">
        {article.data.heroImage && (
            <img src={article.data.heroImage} alt="" class="hero-image" />
        )}

        <div class="hero-content">
            <span class="eyebrow">Featured news</span>

            <h1>{article.data.title}</h1>

            <p>{article.data.description}</p>

            <a href={`/news/${article.id}/`} class="hero-button">
                Read full article &rarr;
            </a>
        </div>
    </section>
)}

<style>
  .news-hero {
    position: relative;
    min-height: 500px;
    display: flex;
    align-items: center;
    isolation: isolate;
    overflow: hidden;
    background: #172033;
    color: white;
  }

  .hero-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
  }

  .news-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      rgba(0, 0, 0, 0.85),
      rgba(0, 0, 0, 0.25)
    );
    z-index: -1;
  }

  .hero-content {
    max-width: 700px;
    padding: clamp(1.5rem, 6vw, 5rem);
  }

  .eyebrow {
    text-transform: uppercase;
    letter-spacing: 2px;
    font-size: 0.875rem;
  }

  h1 {
    font-size: clamp(2rem, 5vw, 4rem);
    line-height: 1.1;
    margin: 1rem 0;
  }

  p {
    font-size: 1.125rem;
    line-height: 1.6;
  }

  .hero-button {
    display: inline-block;
    margin-top: 1.5rem;
    padding: 1rem 1.5rem;
    background: white;
    color: #111;
    text-decoration: none;
    border-radius: 4px;
    font-weight: 600;
  }
</style>